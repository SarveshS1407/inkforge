# =============================================================================
# INKFORGE — Environment Configuration Specification
# =============================================================================

# 1. DATABASE CONFIGURATION
# Local Prototyping (SQLite): Zero-dependency local file database
DATABASE_URL="file:./dev.db"

# Production / Staging (PostgreSQL): High-concurrency relational data store
# DATABASE_URL="postgresql://inkforge_user:secure_password@localhost:5432/inkforge?schema=public&sslmode=prefer"

# 2. RUNTIME & APPLICATION ENVIRONMENT
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. EMAIL DELIVERY (Verification & Password Reset)
# In development (no key set): Verification links are captured in-memory and printed to terminal console.
# For real inbox delivery: Obtain a free API key at https://resend.com and configure:
# RESEND_API_KEY="re_123456789..."
# EMAIL_FROM="INKFORGE <onboarding@resend.dev>"

# 4. FUTURE AUTHENTICATION (OAuth Providers)
# GITHUB_ID="optional_oauth_client_id"
# GITHUB_SECRET="optional_oauth_client_secret"

# 5. FUTURE AI & MEDIA ASSISTANCE (Phase 3+)
# Server-side provider keys — NEVER expose to browser or client bundles
# OPENAI_API_KEY="sk-..."
# GEMINI_API_KEY="..."
