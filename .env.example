# =============================================================================
# INKFORGE — Production & Staging Environment Configuration Specification
# =============================================================================

# 1. DATABASE CONFIGURATION
# Local Prototyping (SQLite): Zero-dependency local file database
DATABASE_URL="file:./prisma/dev.db"

# Production Managed PostgreSQL (Supabase / Neon / AWS RDS / Railway):
# Connection Pooling URL (Transaction Mode on port 6543 - for Next.js runtime queries):
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Database URL (Session/Direct on port 5432 - for Prisma CLI migrations):
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# 2. RUNTIME & APPLICATION ENVIRONMENT
NODE_ENV="development" # Set to "production" in production environments
NEXT_PUBLIC_APP_URL="http://localhost:3000" # Production canonical URL e.g. "https://inkforge.press"

# 3. EMAIL DELIVERY (Transactional: Account Verification & Password Reset)
# In development (no key set): Verification links are captured in-memory and printed to terminal console.
# For production inbox delivery: Obtain an API key from https://resend.com
RESEND_API_KEY="" # Format: re_123456789...
EMAIL_FROM="INKFORGE <editors@inkforge.press>" # Must match your verified domain in Resend

# 4. AI WRITING COPILOT PROVIDER KEYS (Server-side only — NEVER expose to browser)
# Option A: Google Gemini API (Recommended Default)
GEMINI_API_KEY="" # Google AI Studio API key
GEMINI_MODEL="gemini-2.5-flash" # Optional override (default: gemini-2.5-flash)

# Option B: OpenAI API (Alternative Provider)
OPENAI_API_KEY="" # OpenAI API key
OPENAI_MODEL="gpt-4o-mini" # Optional override (default: gpt-4o-mini)

# Optional Provider Selection ("gemini", "openai", or "mock" for tests)
INKFORGE_AI_PROVIDER="gemini"
